# BeingU environment template.
# Copy to .env (local) or set these in EAS / Vercel secrets. NEVER commit real values.
#
# Public (safe to ship inside the mobile app — protected by Row Level Security):
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only secrets (NEVER put these in the mobile app, and never prefix with EXPO_PUBLIC_):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SENTRY_AUTH_TOKEN=
# POSTHOG_API_KEY=

# Region note: the primary Supabase project should be hosted in Mumbai (ap-south-1).
