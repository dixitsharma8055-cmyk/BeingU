{
  "expo": {
    "name": "BeingU",
    "slug": "beingu",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "beingu",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FEFCF9",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.beingu.app"
    },
    "android": {
      "package": "in.beingu.app",
      "adaptiveIcon": {
        "backgroundColor": "#FEFCF9"
      }
    },
    "plugins": ["expo-router", "expo-splash-screen"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
